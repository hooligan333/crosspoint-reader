{
  "schema": 1,
  "id": "tabbed-dashboard",
  "name": "Tabbed Dashboard",
  "description": "A compact dashboard-style theme inspired by tabbed e-reader home screens, with dense cover rows and room for reading-stat cards in compatible apps.",
  "inherits": "lyra",
  "requires": {
    "crosspoint": {
      "schema": 1,
      "modules": [
        "cover-strip"
      ]
    },
    "freeinkui": {
      "schema": 1,
      "components": [
        "header",
        "tab-bar",
        "status-bar",
        "cover-carousel",
        "book-card",
        "metric-card",
        "list"
      ]
    }
  },
  "metrics": {
    "headerHeight": 32,
    "tabBarHeight": 34,
    "topPadding": 2,
    "verticalSpacing": 6,
    "contentSidePadding": 10,
    "homeTopPadding": 10,
    "homeCoverHeight": 260,
    "homeCoverTileHeight": 276,
    "homeRecentBooksCount": 3,
    "homeContinueReadingInMenu": false,
    "homeShowContinueReadingHeader": true,
    "homeMenuTopOffset": 4,
    "menuRowHeight": 44,
    "menuSpacing": 4,
    "listRowHeight": 34,
    "listWithSubtitleRowHeight": 56,
    "buttonHintsHeight": 30,
    "sideButtonHintsWidth": 24,
    "progressBarHeight": 10,
    "progressBarMarginTop": 1,
    "batteryWidth": 14,
    "batteryHeight": 9,
    "batteryBarHeight": 16
  },
  "components": {
    "homeRecents": {
      "type": "cover-strip",
      "maxBooks": 3,
      "wrap": true,
      "drawPanel": true,
      "panelCornerRadius": 5,
      "panelInsetX": 0,
      "selectionLineWidth": 2,
      "inactiveSelectionLineWidth": 0,
      "selectionCornerRadius": 4,
      "slots": [
        {
          "book": "selected",
          "x": "padding",
          "y": "top",
          "height": 168,
          "widthPercent": 46,
          "xOffset": 0,
          "yOffset": 0,
          "selected": true,
          "title": {
            "enabled": true,
            "font": "large",
            "style": "bold",
            "maxLines": 2,
            "offsetY": 8
          }
        },
        {
          "book": "previous",
          "x": "center",
          "y": "center",
          "height": 150,
          "widthPercent": 35,
          "xOffset": -8,
          "yOffset": 74,
          "title": {
            "enabled": true,
            "font": "medium",
            "style": "regular",
            "maxLines": 1,
            "offsetY": 6
          }
        },
        {
          "book": "next",
          "x": "right-padding",
          "y": "center",
          "height": 150,
          "widthPercent": 35,
          "yOffset": 74,
          "title": {
            "enabled": true,
            "font": "medium",
            "style": "regular",
            "maxLines": 1,
            "offsetY": 6
          }
        }
      ]
    },
    "homeMenu": {
      "font": "medium",
      "style": "bold",
      "centeredText": false,
      "centerVertically": true,
      "showIcons": true,
      "drawPanel": true,
      "panelWidth": 0,
      "panelCornerRadius": 4,
      "selectionStyle": "pill",
      "selectionCornerRadius": 4,
      "selectionInset": 8,
      "selectedTextInverted": true,
      "selectionFillBlack": true,
      "rowPaddingX": 10,
      "textInsetX": 10
    },
    "list": {
      "font": "medium",
      "style": "regular",
      "subtitleFontId": 0,
      "valueFontId": 0,
      "showIcons": true,
      "iconSize": 24,
      "textGap": 8,
      "selectionStyle": "pill",
      "selectionCornerRadius": 4,
      "selectionFill": true,
      "selectionOutline": false,
      "selectedTextInverted": true,
      "rowBackgrounds": true,
      "centerSingleLineRows": true,
      "subtitleRowAutoHeight": true,
      "centerValueVertically": true,
      "rowSidePadding": 6,
      "rowGap": 4,
      "textInsetX": 8,
      "selectionInsetX": 0,
      "selectionInsetY": 1,
      "titleOffsetY": 6,
      "subtitleOffsetY": 25,
      "valueOffsetY": 6,
      "subtitleValueOffsetY": 15,
      "iconOffsetY": 0
    },
    "header": {
      "font": "medium",
      "style": "regular",
      "centeredTitle": false,
      "showDivider": false,
      "titleOffsetY": 0,
      "batteryOffsetY": 2
    },
    "tabBar": {
      "font": "medium",
      "style": "bold",
      "equalWidth": true,
      "selectionStyle": "fill",
      "selectedCornerRadius": 4,
      "selectedTextInverted": true,
      "drawDivider": false,
      "horizontalInset": 1
    },
    "buttonHints": {
      "font": "small",
      "style": "regular",
      "buttonWidth": 70,
      "smallButtonHeight": 13,
      "cornerRadius": 4,
      "fill": true,
      "outline": false,
      "drawEmpty": false,
      "layout": "shapes",
      "shapeSize": 16,
      "textOffsetY": 6
    }
  },
  "freeInkUI": {
    "components": [
      "header",
      "status-bar",
      "tab-bar",
      "book-card",
      "cover-carousel",
      "metric-card",
      "list",
      "button-hints"
    ]
  },
  "screens": {
    "home": {
      "layout": [
        {
          "type": "label",
          "x": 24,
          "y": 0,
          "w": 210,
          "h": 18,
          "text": "Reader",
          "font": "small"
        },
        {
          "type": "label",
          "x": 384,
          "y": 0,
          "w": 72,
          "h": 18,
          "text": "<    >",
          "font": "small"
        },
        {
          "type": "tab-bar",
          "x": 78,
          "y": 22,
          "w": 324,
          "h": 38,
          "labels": [
            "reading",
            "library",
            "network",
            "settings"
          ],
          "icons": [
            "book-open",
            "library",
            "wifi",
            "sliders-horizontal"
          ],
          "selectedIndex": 0,
          "font": "small",
          "style": "bold",
          "gap": 4,
          "radius": 4,
          "outline": false
        },
        {
          "type": "label",
          "x": 24,
          "y": 80,
          "w": 180,
          "h": 18,
          "text": "currently reading",
          "font": "medium",
          "style": "bold"
        },
        {
          "type": "book-card",
          "x": 24,
          "y": 112,
          "w": 432,
          "h": 150,
          "coverWidth": 86,
          "coverHeight": 122,
          "padding": 10,
          "radius": 4,
          "font": "medium"
        },
        {
          "type": "cover-grid",
          "x": 24,
          "y": 300,
          "w": 432,
          "h": 246,
          "columns": 3,
          "count": 3,
          "coverWidth": 106,
          "coverHeight": 164,
          "gap": 14,
          "font": "small",
          "radius": 3
        },
        {
          "type": "label",
          "x": 24,
          "y": 604,
          "w": 180,
          "h": 18,
          "text": "reading stats",
          "font": "medium",
          "style": "bold"
        },
        {
          "type": "metric-cards",
          "x": 24,
          "y": 630,
          "w": 432,
          "h": 96,
          "count": 3,
          "labels": [
            "last read",
            "total read",
            "completed"
          ],
          "gap": 8,
          "font": "small",
          "radius": 4
        }
      ]
    }
  },
  "assets": {
    "freeInkIcons": {
      "book": "book-open",
      "recent": "clock-3",
      "settings": "sliders-horizontal",
      "transfer": "download",
      "library": "library",
      "folder": "folder",
      "wifi": "wifi",
      "hotspot": "router",
      "bookmark": "bookmark"
    }
  },
  "devices": {
    "x3": {
      "constraints": {
        "screenWidth": 480,
        "screenHeight": 800,
        "frontButtons": 4,
        "sideButtons": "up-down"
      }
    },
    "x4": {
      "constraints": {
        "screenWidth": 480,
        "screenHeight": 800,
        "frontButtons": 0,
        "sideButtons": "up-down"
      }
    }
  },
  "extensions": {
    "crossink": {
      "dashboard": {
        "enabled": true,
        "brand": "Reader",
        "topTabs": [
          "reading",
          "library",
          "network",
          "settings"
        ],
        "currentReadingCard": true,
        "statsCards": [
          {
            "id": "last-read",
            "label": "Last read",
            "format": "minutes"
          },
          {
            "id": "total-read",
            "label": "Total read",
            "format": "hours"
          },
          {
            "id": "completed",
            "label": "Completed",
            "format": "books"
          }
        ]
      }
    }
  }
}
